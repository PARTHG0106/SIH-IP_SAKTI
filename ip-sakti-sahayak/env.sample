# Safe default: the application works offline without a key or model.
# Copy to .env in this project and explicitly enable a provider when needed.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=900
LLM_TIMEOUT=30

# Optional credential-file compatibility, off by default.
# Requires LLM_PROVIDER=anthropic|openai and a model; never overrides "none".
ALLOW_PROVIDER_FILE=false

# bm25 is always available. hybrid also requires sentence-transformers.
RETRIEVER=bm25
DENSE_MODEL=intfloat/multilingual-e5-small
TOP_K=6

# Number of retrieved records offered for source selection (not a reranker).
RERANK_TOP_N=4
ABSTAIN_THRESHOLD=0.22
COVERAGE_FLOOR=0.15
MIN_CITATIONS=1

# llm uses the explicitly configured provider; none keeps English-only output.
# IndicTrans2/Bhashini are future integrations, not bundled implementations.
TRANSLATE_PROVIDER=none

# Optional directory for audit/consent metadata. Defaults to the project's logs/.
# IP_SAKTI_LOG_DIR=C:/path/to/private/logs
